rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function requesterUserDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function requesterUserDocExists() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function requesterHasProfile() {
      return isSignedIn() &&
        requesterUserDocExists() &&
        requesterUserDoc().keys().hasAll(['clinicId', 'role']);
    }

    function requesterClinicId() {
      return requesterUserDoc().clinicId;
    }

    function isAdmin() {
      return requesterHasProfile() &&
        requesterUserDoc().role == 'admin';
    }

    function hasClinicAndProfessional(data) {
      return data.keys().hasAll(['clinicId', 'professionalId']);
    }

    function canAccessClinicalDoc(data) {
      return isAdmin() || (
        hasClinicAndProfessional(data) &&
        data.clinicId == requesterClinicId() &&
        data.professionalId == request.auth.uid
      );
    }

    function isValidClinicalCreate(data) {
      return requesterHasProfile() &&
        hasClinicAndProfessional(data) &&
        data.clinicId == requesterClinicId() &&
        (isAdmin() || data.professionalId == request.auth.uid);
    }

    function isValidClinicalUpdate() {
      return requesterHasProfile() && (
        isAdmin() || (
        hasClinicAndProfessional(resource.data) &&
        resource.data.clinicId == requesterClinicId() &&
        resource.data.professionalId == request.auth.uid &&
        request.resource.data.clinicId == resource.data.clinicId &&
        request.resource.data.professionalId == resource.data.professionalId
      ));
    }

    function hasNoLegacyCompletada(data) {
      return !data.keys().hasAny(['completada']);
    }

    function isValidRutinaEstado(estado) {
      return estado in ['draft', 'active', 'completed', 'archived'];
    }

    function isValidRutinaCreate() {
      return isValidClinicalCreate(request.resource.data) &&
        request.resource.data.keys().hasAll(['estado']) &&
        isValidRutinaEstado(request.resource.data.estado) &&
        hasNoLegacyCompletada(request.resource.data);
    }

    function isValidRutinaUpdate() {
      return isValidClinicalUpdate() &&
        hasNoLegacyCompletada(request.resource.data) &&
        (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['estado']) ||
          isValidRutinaEstado(request.resource.data.estado)
        );
    }

    match /clinics/{clinicId} {
      allow read: if isSignedIn() &&
        (isAdmin() || clinicId == requesterClinicId());
      allow create, update, delete: if isAdmin();
    }

    match /users/{userId} {
      allow read: if isSignedIn() && request.auth.uid == userId;
      allow create: if isSignedIn() &&
        request.auth.uid == userId &&
        request.resource.data.keys().hasAll(['clinicId', 'role']);
      allow update: if isSignedIn() &&
        request.auth.uid == userId &&
        request.resource.data.clinicId == resource.data.clinicId;
      allow delete: if false;
    }

    match /pacientes/{pacienteId} {
      allow read: if isSignedIn() && canAccessClinicalDoc(resource.data);
      allow create: if isSignedIn() && isValidClinicalCreate(request.resource.data);
      allow update: if isSignedIn() && isValidClinicalUpdate();
      allow delete: if isSignedIn() && canAccessClinicalDoc(resource.data);
    }

    match /sesiones/{sesionId} {
      allow read: if isSignedIn() && canAccessClinicalDoc(resource.data);
      allow create: if isSignedIn() && isValidClinicalCreate(request.resource.data);
      allow update: if isSignedIn() && isValidClinicalUpdate();
      allow delete: if isSignedIn() && canAccessClinicalDoc(resource.data);
    }

    match /rutinas/{rutinaId} {
      allow read: if isSignedIn() && canAccessClinicalDoc(resource.data);
      allow create: if isSignedIn() && isValidRutinaCreate();
      allow update: if isSignedIn() && isValidRutinaUpdate();
      allow delete: if isSignedIn() && canAccessClinicalDoc(resource.data);
    }


    match /evoluciones/{id} {
      allow create: if request.auth != null
        && requesterHasProfile()
        && request.resource.data.clinicId == requesterClinicId()
        && request.resource.data.professionalId == request.auth.uid;

      allow read: if request.auth != null
        && requesterHasProfile()
        && resource.data.clinicId == requesterClinicId();

      allow update: if request.auth != null
        && requesterHasProfile()
        && resource.data.professionalId == request.auth.uid
        && resource.data.clinicId == requesterClinicId()
        && request.resource.data.sessionNumber == resource.data.sessionNumber
        && request.resource.data.clinicId == resource.data.clinicId
        && request.resource.data.professionalId == resource.data.professionalId
        && request.resource.data.createdAt == resource.data.createdAt;

      allow delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
