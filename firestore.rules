rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function requesterUserDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function requesterUserDocExists() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function requesterHasProfile() {
      return isSignedIn() &&
        requesterUserDocExists() &&
        requesterUserDoc().keys().hasAll(['role']);
    }

    function isSuperAdmin() {
      return requesterHasProfile() &&
        requesterUserDoc().role == 'superadmin';
    }

    function isAdmin() {
      return requesterHasProfile() &&
        requesterUserDoc().role == 'admin';
    }

    function requesterClinicId() {
      return requesterUserDoc().clinicId;
    }

    function belongsToSameClinic(data) {
      return requesterHasProfile() &&
        requesterUserDoc().keys().hasAny(['clinicId']) &&
        data.clinicId == requesterClinicId();
    }

    function canReadClinicalDoc(data) {
      return isSuperAdmin() || belongsToSameClinic(data);
    }

    function protectImmutableFields() {
      return request.resource.data.clinicId == resource.data.clinicId &&
        request.resource.data.professionalId == resource.data.professionalId &&
        request.resource.data.createdAt == resource.data.createdAt;
    }

    function canEditClinicalDoc() {
      return requesterHasProfile() &&
        belongsToSameClinic(resource.data) &&
        (
          isAdmin() ||
          (
            resource.data.professionalId == request.auth.uid &&
            protectImmutableFields()
          )
        );
    }

    function isValidClinicalCreate(data) {
      return requesterHasProfile() &&
        data.keys().hasAll(['clinicId','professionalId','createdAt','updatedAt']) &&
        data.clinicId == requesterClinicId() &&
        data.professionalId == request.auth.uid &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isActive(data) {
      return !data.keys().hasAny(['isDeleted']) || data.isDeleted == false;
    }

    match /clinics/{clinicId} {
      allow read: if isSuperAdmin() ||
        (requesterHasProfile() && clinicId == requesterClinicId());

      allow create, update, delete: if isSuperAdmin();
    }



    match /users/{userId} {

      allow read: if isSuperAdmin() ||
        request.auth.uid == userId;

      allow create: if isSuperAdmin();

      allow update: if isSuperAdmin() ||
        request.auth.uid == userId;

      allow delete: if isSuperAdmin();
    }

    match /pacientes/{id} {
      allow read: if canReadClinicalDoc(resource.data) && isActive(resource.data);
      allow create: if isValidClinicalCreate(request.resource.data);
      allow update: if canEditClinicalDoc();
      allow delete: if isAdmin() && belongsToSameClinic(resource.data);
    }

    match /sesiones/{id} {
      allow read: if canReadClinicalDoc(resource.data) && isActive(resource.data);
      allow create: if isValidClinicalCreate(request.resource.data);
      allow update: if canEditClinicalDoc();
      allow delete: if isAdmin() && belongsToSameClinic(resource.data);
    }

    match /rutinas/{id} {
      allow read: if canReadClinicalDoc(resource.data) && isActive(resource.data);
      allow create: if isValidClinicalCreate(request.resource.data);
      allow update: if canEditClinicalDoc();
      allow delete: if isAdmin() && belongsToSameClinic(resource.data);
    }

    match /testTemplates/{id} {
      allow read: if isSignedIn();
      allow create, update, delete: if isSuperAdmin();
    }


    match /evoluciones/{id} {
      allow read: if canReadClinicalDoc(resource.data) && isActive(resource.data);
      allow create: if isValidClinicalCreate(request.resource.data);
      allow update: if
        canEditClinicalDoc() &&
        request.resource.data.sessionNumber == resource.data.sessionNumber;
      allow delete: if isAdmin() && belongsToSameClinic(resource.data);
    }

    match /tratamientos/{id} {
      allow read: if canReadClinicalDoc(resource.data);
      allow create: if isValidClinicalCreate(request.resource.data);
      allow update: if canEditClinicalDoc();
      allow delete: if isAdmin() && belongsToSameClinic(resource.data);
    }
  }
}