rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uidField) {
      return isSignedIn() && request.auth.uid == uidField;
    }

    function isAdmin() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    match /users/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow create: if isSignedIn() && request.auth.uid == userId;
      allow update, delete: if isSignedIn() && (request.auth.uid == userId || isAdmin());
    }

    match /pacientes/{pacienteId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update, delete: if isSignedIn();
    }

    match /sesiones/{sesionId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update, delete: if isSignedIn();
    }

    match /documentos/{documentoId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update, delete: if isSignedIn();
    }


    match /test_templates/{testId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isSignedIn();
    }

    match /ejercicios/{ejercicioId} {
      allow read: if true;
      allow write: if isSignedIn();

      match /{subCollection=**}/{docId} {
        allow read: if true;
        allow write: if isSignedIn();
      }
    }

    match /rutinas/{rutinaId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update, delete: if isSignedIn();

      match /{subCollection=**}/{docId} {
        allow read: if isSignedIn();
        allow create, update, delete: if isSignedIn();
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
